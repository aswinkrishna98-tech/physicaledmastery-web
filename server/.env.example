# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it holds secrets that must stay server-side only.

# ---- Razorpay ----
# Get these from https://dashboard.razorpay.com/app/keys
# Use the "Test Mode" keys first (they start with rzp_test_) to try the whole
# flow with fake money before ever touching rzp_live_ keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Get this from Razorpay Dashboard -> Account & Settings -> Webhooks
# (create a webhook pointing at https://YOUR_DEPLOYED_URL/api/webhook,
# subscribe to at least "payment.captured", and copy the secret it gives you)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Server ----
PORT=4000

# Comma-separated list of origins allowed to call this API (your front-end's
# origin). Leave as * only for local testing.
CORS_ORIGIN=*
